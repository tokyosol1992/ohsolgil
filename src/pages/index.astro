---
import '../styles/global.css';

// 헤더 메뉴 = 페이지의 대분류 섹션 (id와 동일). 스크롤 위치에 따라 현재 항목이 표시됨
const menu = [
  { id: 'about', label: '소개' },
  { id: 'experience', label: '경력' },
  { id: 'projects', label: '프로젝트' },
  { id: 'docs', label: '문서' },
  { id: 'contact', label: '연락처' },
];

const about = [
  { n: '01', title: '플랫폼 설계', text: '핵심 역량 문장이 들어갑니다. (직접 정리해 주시는 내용으로 채웁니다)' },
  { n: '02', title: '디자인 시스템', text: '핵심 역량 문장이 들어갑니다.' },
  { n: '03', title: '키오스크 · 모바일 앱', text: '핵심 역량 문장이 들어갑니다.' },
];

const jobs = [
  { when: '기간 입력 예정', company: '포웍스', team: '직무 · 팀', points: ['담당 업무와 성과가 들어갑니다.', '그로우 프로젝트 포함'] },
  { when: '기간 입력 예정', company: '회사 이름', team: '직무 · 팀', points: ['담당 업무와 성과가 들어갑니다.'] },
];

// 이름은 Figma 포트폴리오 표지 기준. 요약·태그는 받은 내용만 채울 것.
const projects = [
  { name: '그로우', label: 'GROW', summary: '포웍스 · 요약 입력 예정', tags: [] },
  { name: '마켓보로', label: 'MARKETBORO', tags: [] },
  { name: '던킨 키오스크', label: 'DUNKIN KIOSK', tags: ['키오스크'] },
  { name: '할인꾹', label: 'HALIN-KKUK', tags: [] },
  { name: '바르미', label: 'BARMI', tags: [] },
  { name: '해피오더', label: 'HAPPY ORDER', tags: [] },
  { name: '해피포인트', label: 'HAPPY POINT', tags: [] },
  { name: '배스킨 키오스크', label: 'BASKIN KIOSK', tags: ['키오스크'] },
];

const docs = [
  { title: '포트폴리오', sub: 'A Bit Nerdy · 2016–2025' },
  { title: '이력서', sub: '파일 준비되면 연결' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#09090b" />
    <meta name="description" content="플랫폼과 디자인 시스템을 만드는 8년 차 프로덕트 디자이너 Oh SolGil의 포트폴리오" />
    <title>Oh SolGil — Product Designer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+KR:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <header id="site-header">
      <div class="bar">
        <div class="pill">
          <a class="logo" href="#top">Oh SolGil<i>.</i></a>
          <nav aria-label="섹션">
            <span class="nav-ind" aria-hidden="true"></span>
            {menu.map((m) => <a href={`#${m.id}`} data-spy={m.id}>{m.label}</a>)}
          </nav>
          <a class="btn primary" href="#docs">이력서</a>
          <button class="menu-btn" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="menu"><i></i><i></i></button>
        </div>
        <div class="menu" id="menu" hidden>
          {menu.map((m, i) => <a href={`#${m.id}`} data-spy={m.id}><span>{m.label}</span><small>{String(i + 1).padStart(2, '0')}</small></a>)}
        </div>
      </div>
    </header>

    <main id="top">
      <div class="hero-full" data-dots-host>
        <canvas class="dots" aria-hidden="true"></canvas>
      <div class="wrap hero">
        <span class="avail">프로젝트 · 협업 제안 환영</span>
        <h1>Oh SolGil</h1>
        <div class="role">Product Designer</div>
        <p class="lead">플랫폼과 디자인 시스템을 만드는 8년 차 프로덕트 디자이너입니다.</p>
        <div class="cta">
          <a class="btn primary" href="#docs">포트폴리오 PDF 받기</a>
          <a class="btn" href="#projects">프로젝트 보기</a>
        </div>
        <div class="facts">
          <span><b>8년</b> 차</span><span><b>2016–2025</b> 작업 기록</span><span><b>{projects.length}개</b> 대표 프로젝트</span><span>서울</span>
        </div>
      </div>
      </div>

      <div class="wrap">
      <section id="about">
        <div class="sh"><h2>소개</h2><p>무엇을 잘하고, 어떻게 일하는지</p></div>
        <div class="grid3">
          {about.map((a) => (
            <div class="card"><div class="ic">{a.n}</div><h3>{a.title}</h3><p class="ph">{a.text}</p></div>
          ))}
        </div>
      </section>

      <section id="experience">
        <div class="sh"><h2>경력</h2><p>2016 → 2025</p></div>
        <div class="tl">
          {jobs.map((j) => (
            <div class="job">
              <div class="when">{j.when}</div>
              <div>
                <h3>{j.company}</h3>
                <div class="team ph">{j.team}</div>
                <ul class="ph">{j.points.map((p) => <li>{p}</li>)}</ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="projects">
        <div class="sh"><h2>프로젝트</h2><p>Figma 포트폴리오 기준 대표작</p></div>
        <div class="projects">
          {projects.map((p) => (
            <div class="proj">
              <div class="thumb">{p.label}</div>
              <div class="pb">
                <h3>{p.name}</h3>
                <p class={p.summary ? '' : 'ph'}>{p.summary ?? '요약 입력 예정'}</p>
                <div class="tags">
                  {p.tags.map((t) => <span class="tag">{t}</span>)}
                  <span class="tag soon">상세 준비 중</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="docs">
        <div class="sh"><h2>문서</h2><p>내려받아 보실 수 있어요</p></div>
        <div class="docs">
          {docs.map((d) => (
            <a class="doc" href="#docs"><div class="fi">PDF</div><div><b>{d.title}</b><small>{d.sub}</small></div><span class="dl">↓</span></a>
          ))}
        </div>
      </section>

      <section id="contact">
        <div class="sh"><h2>연락처</h2><p>편하게 연락 주세요</p></div>
        <div class="contact">
          <div class="card"><span class="mono">Email</span><b class="ph">이메일 입력 예정</b></div>
          <a class="card" href="https://github.com/tokyosol1992"><span class="mono">GitHub</span><b>github.com/tokyosol1992</b></a>
          <div class="card"><span class="mono">LinkedIn</span><b class="ph">링크 입력 예정</b></div>
        </div>
      </section>

      <a class="sib" href="https://tokyosol1992.github.io">
        <div><span class="mono">Sibling site</span><h3>MoHo</h3><p>디자인 팁, AI 프롬프트, 툴, 작업 기록을 모아 두는 라이브러리</p></div>
        <div class="wm">MoHo →</div>
      </a>
      <footer><span>© 2026 Oh SolGil</span><span>Seoul</span></footer>
      </div>
    </main>
    <script>
      import { initHeader } from '../scripts/header';
      import { initDotGrid } from '../scripts/dot-grid';
      initHeader();
      initDotGrid();
    </script>
  </body>
</html>
