---
import '../styles/global.css';
import '../styles/border-beam.css';
import '../styles/border-glow.css';
import { period, PERIOD_PLACEHOLDER } from '../lib/period';

// 헤더 메뉴 = 페이지의 대분류 섹션 (id와 동일). 스크롤 위치에 따라 현재 항목이 표시됨. ko는 검색 키워드
const menu = [
  { id: 'about', label: 'About', ko: '소개' },
  { id: 'experience', label: 'Experience', ko: '경력' },
  { id: 'projects', label: 'Projects', ko: '프로젝트' },
  { id: 'docs', label: 'Docs', ko: '문서' },
  { id: 'contact', label: 'Contact', ko: '연락처' },
];

// 기간은 연차 대신 `YYYY - YYYY` / `YYYY.MM.DD` (src/lib/period.ts)
const career = period('2016', '2025')!;

const about = [
  { n: '01', title: '플랫폼 설계', text: '핵심 역량 문장이 들어갑니다. (직접 정리해 주시는 내용으로 채웁니다)' },
  { n: '02', title: '디자인 시스템', text: '핵심 역량 문장이 들어갑니다.' },
  { n: '03', title: '키오스크 · 모바일 앱', text: '핵심 역량 문장이 들어갑니다.' },
];

// start/end: 'YYYY' 또는 'YYYY.MM.DD', 재직 중이면 end: '현재'. 비어 있으면 자리 표시
const jobs = [
  { start: '', end: '', company: '포웍스', team: '직무 · 팀', points: ['담당 업무와 성과가 들어갑니다.', '그로우 프로젝트 포함'] },
  { start: '', end: '', company: '회사 이름', team: '직무 · 팀', points: ['담당 업무와 성과가 들어갑니다.'] },
].map((j) => ({ ...j, when: period(j.start, j.end) }));

// 이름은 Figma 포트폴리오 표지 기준. 요약·태그는 받은 내용만 채울 것.
const projects = [
  { name: '그로우', label: 'GROW', summary: '포웍스 · 요약 입력 예정', tags: [] },
  { name: '마켓보로', label: 'MARKETBORO', tags: [] },
  { name: '던킨 키오스크', label: 'DUNKIN KIOSK', tags: ['키오스크'] },
  { name: '할인꾹', label: 'HALIN-KKUK', tags: [] },
  { name: '바르미', label: 'BARMI', tags: [] },
  { name: '해피오더', label: 'HAPPY ORDER', tags: [] },
  { name: '해피포인트', label: 'HAPPY POINT', tags: [] },
  { name: '배스킨 키오스크', label: 'BASKIN KIOSK', tags: ['키오스크'] },
] as { name: string; label: string; summary?: string; tags: string[] }[];

const docs = [
  { title: '포트폴리오', sub: `A Bit Nerdy · ${career}` },
  { title: '이력서', sub: '파일 준비되면 연결' },
];

const contacts = [
  { label: 'Email', value: '', href: '' },
  { label: 'GitHub', value: 'github.com/tokyosol1992', href: 'https://github.com/tokyosol1992' },
  { label: 'LinkedIn', value: '', href: '' },
];

// Soft Aurora 설정 (React Bits SoftAurora props와 같음). 은은한 블루: 무지개 끔(spectrum 0), 밝기·불투명도 낮춤
const aurora = { color1: '#8fd0ff', color2: '#2895f7', spectrum: 0, brightness: 0.9, opacity: 0.75, speed: 0.35, scale: 0.9, noiseAmplitude: 0.8, bandHeight: 0.12, bandSpread: 0.6, mouseInfluence: 0.25 };

// 히어로 오로라: 밝기는 많이 낮추고(brightness·opacity) 띠를 넓게(bandSpread 낮을수록 넓음, scale 낮을수록 굵게 휨) + CSS blur
const heroAurora = { color1: '#8fd0ff', color2: '#2895f7', spectrum: 0, brightness: 0.7, opacity: 0.7, speed: 0.3, scale: 0.8, noiseAmplitude: 0.9, bandHeight: 0.55, bandSpread: 0.5, mouseInfluence: 0.3 };

const moho = { title: 'MoHo', text: '디자인 팁, AI 프롬프트, 툴, 작업 기록을 모아 두는 라이브러리', href: 'https://tokyosol1992.github.io' };

// ── 전체 검색 색인 (헤더 Search / ⌘K·Ctrl+K). 페이지 데이터에서 자동으로 만들어짐 ──
// g: 그룹, t: 제목, s: 보조 문구, k: 추가 키워드, h: 이동할 곳(#id 또는 외부 주소)
type Hit = { g: string; t: string; s?: string; k?: string; h: string };
const searchIndex: Hit[] = [
  ...menu.map((m) => ({ g: '섹션', t: m.label, s: m.ko, k: m.ko, h: `#${m.id}` })),
  ...projects.map((p, i) => ({ g: '프로젝트', t: p.name, s: p.label, k: [p.label, ...p.tags, p.summary ?? ''].join(' '), h: `#project-${i + 1}` })),
  ...jobs.map((j, i) => ({ g: '경력', t: j.company, s: j.when ?? j.team, k: j.points.join(' '), h: `#job-${i + 1}` })),
  ...about.map((a) => ({ g: '핵심 역량', t: a.title, s: 'About', h: `#about-${a.n}` })),
  ...docs.map((d, i) => ({ g: '문서', t: d.title, s: d.sub, k: 'PDF 이력서 resume portfolio 다운로드', h: `#doc-${i + 1}` })),
  ...contacts.map((c) => ({ g: '연락처', t: c.label, s: c.value || 'Contact', k: '연락 메일 contact', h: c.href || '#contact' })),
  { g: '링크', t: moho.title, s: '형제 사이트 · 디자인 라이브러리', k: '모호 블로그 팁 AI 프롬프트 툴 기록 library', h: moho.href },
];
const searchJson = JSON.stringify(searchIndex).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#09090b" />
    <meta name="description" content={`플랫폼과 디자인 시스템을 만드는 프로덕트 디자이너 Oh SolGil의 포트폴리오 (${career})`} />
    <title>Oh SolGil — Product Designer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+KR:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <!-- 키보드 사용자용: Tab을 처음 누르면 왼쪽 위에 나타남 (평소엔 안 보임) -->
    <a class="skip" href="#top">본문으로 건너뛰기</a>
    <header id="site-header">
      <div class="bar">
        <div class="pill">
          <a class="logo" href="#top">Oh SolGil<i>.</i></a>
          <span class="sep" aria-hidden="true">/</span>
          <nav aria-label="Sections">
            <span class="nav-ind" aria-hidden="true"></span>
            {menu.map((m) => <a href={`#${m.id}`} data-spy={m.id}>{m.label}</a>)}
          </nav>
          <!-- 검색 영역: Resume와 같은 크기. 테두리를 360° 도는 파란 빛(border-beam.css) -->
          <div class="sk-beam" data-beam="sk-bar" data-active>
            <button class="sk-trigger" type="button" data-sk-open aria-haspopup="dialog" aria-controls="search" aria-keyshortcuts="Control+K Meta+K" title="검색 (Ctrl K)" data-sk-title>
              <svg class="sk-ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg>
              <span class="sk-label">Search</span>
                <span class="sr-only">검색 열기 (단축키 Ctrl 또는 ⌘ + K)</span>
            </button>
            <div data-beam-bloom></div>
          </div>
          <a class="btn primary" href="#docs">Resume</a>
          <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu"><i></i><i></i></button>
        </div>
        <div class="menu" id="menu" hidden>
          {menu.map((m, i) => <a href={`#${m.id}`} data-spy={m.id}><span>{m.label}</span><small>{String(i + 1).padStart(2, '0')}</small></a>)}
        </div>
      </div>
    </header>

    <main id="top" tabindex="-1">
      <div class="hero-full" data-dots-host>
        <!-- 히어로 뒤 은은한 블루 오로라 (닷 그리드 아래) -->
        <div class="hero-aurora" aria-hidden="true" data-aurora={JSON.stringify(heroAurora)}></div>
        <canvas class="dots" aria-hidden="true"></canvas>
      <div class="wrap hero">
        <span class="avail">프로젝트 · 협업 제안 환영</span>
        <h1>Oh SolGil</h1>
        <div class="role">Product Designer</div>
        <p class="lead">플랫폼과 디자인 시스템을 만드는 프로덕트 디자이너입니다.</p>
        <div class="cta">
          <a class="btn primary" href="#docs">포트폴리오 PDF 받기</a>
          <a class="btn" href="#projects">프로젝트 보기</a>
        </div>
        <div class="facts">
          <span><b>{career}</b> 작업 기록</span><span><b>{projects.length}개</b> 대표 프로젝트</span><span>서울</span>
        </div>
      </div>
      </div>

      <div class="wrap">
      <section id="about" tabindex="-1">
        <div class="sh"><h2>About</h2><p>What I do well and how I work</p></div>
        <div class="grid3">
          {about.map((a) => (
            <div class="card" id={`about-${a.n}`} tabindex="-1" data-glow><span class="edge-light" aria-hidden="true"></span><div class="ic">{a.n}</div><h3>{a.title}</h3><p class="ph">{a.text}</p></div>
          ))}
        </div>
      </section>

      <section id="experience" tabindex="-1">
        <div class="sh"><h2>Experience</h2><p>{career}</p></div>
        <div class="tl">
          {jobs.map((j, i) => (
            <div class="job" id={`job-${i + 1}`} tabindex="-1" data-glow>
              <span class="edge-light" aria-hidden="true"></span>
              <div class:list={['when', { ph: !j.when }]}>{j.when ?? PERIOD_PLACEHOLDER}</div>
              <div>
                <h3>{j.company}</h3>
                <div class="team ph">{j.team}</div>
                <ul class="ph">{j.points.map((p) => <li>{p}</li>)}</ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="projects" tabindex="-1">
        <div class="sh"><h2>Projects</h2><p>Selected work from my portfolio</p></div>
        <div class="projects" data-swipe>
          {projects.map((p, i) => (
            <div class="proj" id={`project-${i + 1}`} tabindex="-1" data-glow>
              <span class="edge-light" aria-hidden="true"></span>
              <div class="thumb">{p.label}</div>
              <div class="pb">
                <h3>{p.name}</h3>
                <p class={p.summary ? '' : 'ph'}>{p.summary ?? '요약 입력 예정'}</p>
                <div class="tags">
                  {p.tags.map((t) => <span class="tag">{t}</span>)}
                  <span class="tag soon">상세 준비 중</span>
                </div>
              </div>
            </div>
          ))}
        </div>
        <!-- 모바일(≤720px)에서만 보임: 가로 스크롤 진행 표시 -->
        <div class="swipe-meta" aria-hidden="true">
          <span class="swipe-bar"><i data-swipe-bar></i></span>
          <span class="swipe-count"><b data-swipe-now>01</b> / {String(projects.length).padStart(2, '0')}</span>
        </div>
      </section>

      <section id="docs" tabindex="-1">
        <div class="sh"><h2>Docs</h2><p>Available to download</p></div>
        <div class="docs">
          {docs.map((d, i) => (
            <a class="doc" id={`doc-${i + 1}`} href="#docs" data-glow><span class="edge-light" aria-hidden="true"></span><div class="fi">PDF</div><div><b>{d.title}</b><small>{d.sub}</small></div><span class="dl">↓</span></a>
          ))}
        </div>
      </section>

      <section id="contact" tabindex="-1">
        <div class="sh"><h2>Contact</h2><p>Get in touch</p></div>
        <div class="contact">
          {contacts.map((c) =>
            c.href ? (
              <a class="card" href={c.href} data-glow><span class="edge-light" aria-hidden="true"></span><span class="mono">{c.label}</span><b>{c.value}</b></a>
            ) : (
              <div class="card" data-glow><span class="edge-light" aria-hidden="true"></span><span class="mono">{c.label}</span><b class="ph">{c.label === 'Email' ? '이메일 입력 예정' : '링크 입력 예정'}</b></div>
            ),
          )}
        </div>
      </section>

      <!-- MoHo 카드: 뒤에 은은한 블루 Soft Aurora + 테두리 Border Glow -->
      <a class="sib" href={moho.href} data-glow>
        <span class="edge-light" aria-hidden="true"></span>
        <div class="sib-aurora" aria-hidden="true" data-aurora={JSON.stringify(aurora)}></div>
        <div><span class="mono">Sibling site</span><h3>{moho.title}</h3><p>{moho.text}</p></div>
        <div class="wm">MoHo →</div>
      </a>
      <footer><span>© 2026 Oh SolGil</span><span>Seoul</span></footer>
      </div>
    </main>

    <!-- 전체 검색: 헤더 Search 버튼 또는 ⌘K / Ctrl+K로 화면 가운데에 열림 (src/scripts/search.ts) -->
    <dialog class="sk" id="search" aria-label="사이트 검색">
      <div class="sk-panel">
        <div class="sk-beam" data-beam="sk-field" data-active>
          <div class="sk-field">
            <svg class="sk-ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg>
            <input id="sk-input" type="text" placeholder="프로젝트, 경력, 문서 검색" autocomplete="off" spellcheck="false" enterkeyhint="go"
              role="combobox" aria-expanded="true" aria-controls="sk-list" aria-autocomplete="list" aria-label="검색어" />
            <button class="sk-close" type="button" data-sk-close><span class="d" aria-hidden="true">ESC</span><span class="m" aria-hidden="true">닫기</span><span class="sr-only">검색 닫기</span></button>
          </div>
          <div data-beam-bloom></div>
        </div>
        <div class="sk-list" id="sk-list" role="listbox" aria-label="검색 결과"></div>
        <div class="sk-foot">
          <span class="keys"><kbd>↑</kbd><kbd>↓</kbd> 이동</span>
          <span class="keys"><kbd>↵</kbd> 열기</span>
          <span class="keys"><kbd>esc</kbd> 닫기</span>
          <span class="sk-count" aria-live="polite"></span>
        </div>
      </div>
    </dialog>
    <script type="application/json" id="sk-data" set:html={searchJson} />

    <script>
      import { initHeader } from '../scripts/header';
      import { initDotGrid } from '../scripts/dot-grid';
      import { initSearch } from '../scripts/search';
      import { initSwipe } from '../scripts/swipe';
      import { initBorderGlow } from '../scripts/border-glow';
      import { initSoftAurora } from '../scripts/soft-aurora';
      initHeader();
      initDotGrid();
      initSearch();
      initSwipe();
      initBorderGlow();
      initSoftAurora();
    </script>
  </body>
</html>
